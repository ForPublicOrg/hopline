<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground" android:minHeight="72dp">

    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/bg_avatar" android:maxLines="1" />
        <View android:id="@+id/dot" android:layout_width="13dp" android:layout_height="13dp"
            android:layout_gravity="bottom|end" android:background="@drawable/bg_dot" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp">
        <!-- As wide as the name, so a verified person's shield sits right after it -->
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text"
            android:maxLines="1" android:ellipsize="end" android:drawablePadding="6dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Muted" android:textSize="13.5sp" android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Labels at the row's end, one above the other: "Group admin", then "Internet". The gaps belong to the labels: a
         GONE label's margin doesn't count and the divider shows only between two, so a row with none keeps its full
         width, and a lone one stays centred. -->
    <LinearLayout android:id="@+id/badges" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end"
        android:divider="@drawable/gap_badges" android:showDividers="middle">
        <!-- "Group admin": the group's own colour (ember), not the outside world's blue -->
        <TextView android:id="@+id/admin_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/group_admin" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ember_deep"
            android:background="@drawable/bg_badge_admin" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="8dp"
            android:maxLines="1" android:visibility="gone" />
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/has_internet" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/internet_badge"
            android:background="@drawable/bg_badge" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:layout_marginStart="8dp" android:maxLines="1" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
