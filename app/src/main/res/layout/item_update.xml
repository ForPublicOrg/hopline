<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a newer Hopline is out / on its way / ready to install. An offer, never a demand: the ×
     closes it for that version for good, and Settings → About still has it for later. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
    android:background="@drawable/bg_menu_card" android:paddingStart="14dp" android:paddingEnd="4dp"
    android:paddingTop="6dp" android:paddingBottom="6dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:baselineAligned="false">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="13dp"
            android:src="@drawable/ic_update" android:importantForAccessibility="no" />

        <!-- TalkBack reads the two lines as one (the description is set in code), and again when the state changes -->
        <LinearLayout android:id="@+id/update_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="12dp" android:paddingTop="12dp" android:paddingBottom="8dp"
            android:importantForAccessibility="yes" android:accessibilityLiveRegion="polite">
            <TextView android:id="@+id/update_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text" android:importantForAccessibility="no" />
            <TextView android:id="@+id/update_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/text_muted"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageButton android:id="@+id/update_dismiss" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
            android:contentDescription="@string/update_dismiss" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/update_progress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="34dp" android:layout_marginEnd="14dp" android:layout_marginTop="2dp" android:layout_marginBottom="10dp"
        android:max="1000" android:visibility="gone" android:importantForAccessibility="no"
        app:indicatorColor="@color/ember" app:trackColor="@color/surface_variant" app:trackCornerRadius="2dp" />

    <LinearLayout android:id="@+id/update_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginEnd="6dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/update_secondary" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/text_muted"
            android:visibility="gone" style="@style/Widget.Material3.Button.TextButton" />
        <com.google.android.material.button.MaterialButton android:id="@+id/update_primary" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/ember"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</LinearLayout>
