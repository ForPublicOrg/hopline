<?xml version="1.0" encoding="utf-8"?>
<!-- Someone paid from this phone before: tap to pay them again, long-press to remove. The name is
     the one their code gave (or the UPI ID, when it gave none); the bank shows the real one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:foreground="?attr/selectableItemBackground" android:minHeight="64dp"
    android:clickable="true" android:focusable="true" android:longClickable="true">

    <TextView android:id="@+id/avatar" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
        android:background="@drawable/bg_net_icon" android:importantForAccessibility="no" android:maxLines="1"
        android:textSize="17sp" android:textStyle="bold" android:textColor="@color/internet_badge" />

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"
            android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
        <TextView android:id="@+id/upi_id" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:textSize="13sp" android:textColor="@color/text_muted"
            android:maxLines="1" android:ellipsize="middle" android:textAlignment="viewStart" />
        <TextView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:textSize="13sp" android:textColor="@color/text_muted"
            android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
    </LinearLayout>
</LinearLayout>
