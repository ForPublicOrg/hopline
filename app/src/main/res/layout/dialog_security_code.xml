<?xml version="1.0" encoding="utf-8"?>
<!-- "Verify security code": who, the number both phones work out, what to do with it, and the mark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp">

    <TextView android:id="@+id/names" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text" />

    <TextView android:id="@+id/number" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:background="@drawable/bg_chip" android:gravity="center"
        android:paddingTop="12dp" android:paddingBottom="12dp" android:fontFamily="monospace"
        android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text" android:lineSpacingExtra="6dp"
        android:textIsSelectable="false" />

    <TextView android:id="@+id/explain" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textAppearance="@style/Text.Muted" android:textSize="14sp" />

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/verified" android:saveEnabled="false"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:layout_marginTop="8dp" android:text="@string/verify_mark" android:textSize="16sp" android:textColor="@color/text" />
</LinearLayout>
