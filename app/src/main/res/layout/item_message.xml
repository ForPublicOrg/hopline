<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp">

    <LinearLayout android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:minWidth="88dp"
        android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="5dp"
        android:background="@drawable/bg_bubble_in" android:elevation="0.5dp">

        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:paddingBottom="2dp" />

        <!-- The message this one replies to: coloured bar, name, snippet. Tap to jump there. -->
        <LinearLayout android:id="@+id/quote_block" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone" android:layout_marginBottom="4dp"
            android:background="@drawable/bg_quote" android:minWidth="120dp">
            <View android:id="@+id/quote_bar" android:layout_width="4dp" android:layout_height="match_parent"
                android:background="@color/ember" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="10dp"
                android:paddingTop="5dp" android:paddingBottom="6dp">
                <TextView android:id="@+id/quote_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                    android:maxWidth="240dp" />
                <TextView android:id="@+id/quote_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:maxWidth="240dp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Photo attachment: thumbnail immediately, real image when every piece has hopped in -->
        <FrameLayout android:id="@+id/image_wrap" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:layout_marginBottom="3dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image" android:layout_width="240dp" android:layout_height="180dp"
                android:scaleType="centerCrop" android:background="@drawable/bg_image_placeholder"
                app:shapeAppearanceOverlay="@style/Shape.Hopline.Image"
                android:contentDescription="@string/attach_photo" />
            <TextView android:id="@+id/image_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:background="@drawable/bg_chip"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textSize="12sp" android:textColor="@color/chip_text" android:visibility="gone" />
        </FrameLayout>

        <!-- Non-image file attachment -->
        <LinearLayout android:id="@+id/file_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:paddingTop="4dp" android:paddingBottom="6dp" android:paddingEnd="8dp">
            <ImageView android:id="@+id/file_icon" android:layout_width="34dp" android:layout_height="34dp"
                android:src="@drawable/ic_file" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/file_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxWidth="220dp"
                    android:maxLines="1" android:ellipsize="middle" />
                <TextView android:id="@+id/file_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A voice note: play/pause, a position bar, and the length -->
        <LinearLayout android:id="@+id/voice_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:paddingTop="4dp" android:paddingBottom="6dp" android:paddingEnd="8dp">
            <ImageView android:id="@+id/voice_play" android:layout_width="38dp" android:layout_height="38dp"
                android:src="@drawable/ic_play" android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp" android:contentDescription="@string/voice_label" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <ProgressBar android:id="@+id/voice_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp" android:layout_height="wrap_content"
                    android:minHeight="4dp" android:maxHeight="4dp" android:max="1000" />
                <TextView android:id="@+id/voice_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A shared place: pin, name, coordinates, and how far it is from this phone -->
        <LinearLayout android:id="@+id/location_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:paddingTop="4dp" android:paddingBottom="6dp" android:paddingEnd="8dp">
            <ImageView android:id="@+id/location_icon" android:layout_width="34dp" android:layout_height="34dp"
                android:src="@drawable/ic_location" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/location_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:maxWidth="220dp"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/location_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:layout_marginTop="1dp" android:maxWidth="220dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/bubble_in_text" android:lineSpacingExtra="1dp"
            android:autoLink="web|phone" android:maxWidth="292dp" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_gravity="end" android:gravity="center_vertical">
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/bubble_in_meta" />
            <TextView android:id="@+id/ticks" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:paddingStart="3dp" android:textColor="@color/tick" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reactions hang off the bubble's bottom edge, WhatsApp-style. Tap to see who. -->
    <TextView android:id="@+id/reactions_pills" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_marginTop="-7dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:background="@drawable/bg_reaction_pill" android:elevation="1dp"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="3dp"
        android:textSize="12sp" android:textColor="@color/text" />
</LinearLayout>
