<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" app:title="@string/settings" app:titleTextColor="@color/text"
        app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text"
        app:navigationContentDescription="@string/back" android:elevation="2dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="16dp">

            <!-- Me: tap to change my name (everyone sees it, on old messages too) -->
            <LinearLayout android:id="@+id/me_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card" android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true" android:padding="16dp">
                <TextView android:id="@+id/me_avatar" android:layout_width="56dp" android:layout_height="56dp"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_avatar" android:maxLines="1" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:id="@+id/me_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/edit_name" android:textSize="13sp" android:textColor="@color/ember" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_edit_name"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- This group: tap for Group info; quick Show code / Rename / Leave.
                 Label and card are hidden while no group is on the radio (every group was left) -->
            <TextView android:id="@+id/group_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginStart="4dp" android:text="@string/this_group" android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:id="@+id/group_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:paddingBottom="12dp">
                <LinearLayout android:id="@+id/group_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp"
                    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="8dp">
                    <TextView android:id="@+id/group_avatar" android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:background="@drawable/bg_avatar" android:maxLines="1" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:id="@+id/group_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text"
                            android:maxLines="2" android:ellipsize="end" />
                        <TextView android:id="@+id/group_code" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:textSize="15sp" android:textColor="@color/text_muted"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:layout_marginTop="4dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/show_code" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/show_invite"
                        android:minHeight="48dp" style="@style/Widget.Hopline.Button.Quiet" app:icon="@drawable/ic_qr"
                        app:iconTint="@color/text" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/rename" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/rename_group"
                        android:minHeight="48dp" style="@style/Widget.Hopline.Button.Quiet" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/leave" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" android:text="@string/leave_group"
                    style="@style/Widget.Hopline.Button.Danger" />
            </LinearLayout>

            <!-- Internet sharing: one switch for every group (it's this phone's data plan) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/share" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/share_internet" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text" />
                <TextView android:id="@+id/share_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/text_muted" />
                <TextView android:id="@+id/share_paused" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/warn_text"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- About: how it works, this phone's version and its updates, where Hopline comes from.
                 It belongs to the phone, not to a group: shown with or without one. -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginStart="4dp" android:text="@string/about" android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" android:background="@drawable/bg_card">
                <LinearLayout android:id="@+id/how" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/how_it_works" android:textSize="16sp" android:textColor="@color/text" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <!-- The version on this phone and what is known about a newer one: the same states
                     as Home's banner, with the action that fits, also after that banner was closed.
                     TalkBack reads the lines as one (the description is set in code). -->
                <LinearLayout android:id="@+id/update_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp"
                    android:paddingBottom="2dp" android:importantForAccessibility="yes">
                    <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/update_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/text_muted"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/update_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/text_muted" android:visibility="gone"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/update_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:max="1000" android:visibility="gone"
                    android:importantForAccessibility="no"
                    app:indicatorColor="@color/ember" app:trackColor="@color/surface_variant" app:trackCornerRadius="2dp" />
                <LinearLayout android:id="@+id/update_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="end" android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton android:id="@+id/update_secondary" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
                        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/text_muted"
                        android:visibility="gone" style="@style/Widget.Material3.Button.TextButton" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/update_primary" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
                        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/ember"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/update_check" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:minHeight="48dp"
                    android:text="@string/update_check_now" style="@style/Widget.Hopline.Button.Quiet" />

                <!-- Off: Hopline neither checks nor downloads by itself; "Check for updates" still works -->
                <LinearLayout android:id="@+id/update_auto_block" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/update_auto" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/update_auto" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="14dp"
                        android:text="@string/update_auto_sub" android:textSize="13sp" android:textColor="@color/text_muted" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp"
                    android:text="@string/made_for" android:textSize="13sp" android:textColor="@color/text_faint" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
