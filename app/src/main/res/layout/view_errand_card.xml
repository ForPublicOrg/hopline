<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp"
    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp"
    android:elevation="1dp">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Text.Body" android:textStyle="bold" />
    <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textAppearance="@style/Text.Body" />
    <TextView android:id="@+id/help_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/errand_send_body" android:textAppearance="@style/Text.Muted" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/open_and_send" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sent" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/i_sent_it" android:minHeight="48dp"
            style="@style/Widget.Hopline.Button.Quiet" />
        <com.google.android.material.button.MaterialButton android:id="@+id/failed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="✕" android:minHeight="48dp" android:minWidth="48dp"
            android:contentDescription="@string/couldnt_send"
            style="@style/Widget.Hopline.Button.Quiet" app:strokeColor="@color/danger" android:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
