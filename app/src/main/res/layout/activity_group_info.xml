<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" app:title="@string/group_info" app:titleTextColor="@color/text"
        app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text"
        app:navigationContentDescription="@string/back" android:elevation="2dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <!-- Who we are: big avatar, the name (tap the pencil to rename for everyone), how many -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal" android:background="@color/surface"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="20dp">
                <TextView android:id="@+id/avatar" android:layout_width="104dp" android:layout_height="104dp"
                    android:gravity="center" android:background="@drawable/bg_avatar" android:textColor="#FFFFFF"
                    android:textSize="44sp" android:textStyle="bold" android:maxLines="1" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <!-- balances the pencil so the name stays centred -->
                    <Space android:layout_width="48dp" android:layout_height="48dp" />
                    <TextView android:id="@+id/group_name" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:textAppearance="@style/Text.Display"
                        android:textSize="24sp" android:maxLines="3" android:ellipsize="end" />
                    <ImageButton android:id="@+id/edit_name" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit_name"
                        android:contentDescription="@string/rename_group" />
                </LinearLayout>
                <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textAppearance="@style/Text.Muted" android:textSize="15sp" android:gravity="center" />
                <TextView android:id="@+id/named_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/text_faint"
                    android:gravity="center" android:visibility="gone" />
            </LinearLayout>

            <!-- The three words, and the two ways to hand them over -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="20dp"
                android:text="@string/your_group_code" android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <TextView android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:gravity="center_vertical" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/text" android:fontFamily="monospace" android:textIsSelectable="false"
                    android:background="?attr/selectableItemBackground" />
                <LinearLayout android:id="@+id/code_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/show_qr" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/show_qr"
                        style="@style/Widget.Hopline.Button.Quiet" app:icon="@drawable/ic_qr" app:iconTint="@color/text"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/share_invite" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="@string/share_invite" style="@style/Widget.Hopline.Button.Quiet"
                        app:icon="@drawable/ic_share" app:iconTint="@color/text" app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mute -->
            <LinearLayout android:id="@+id/mute_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_card" android:foreground="?attr/selectableItemBackground"
                android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bell_outline"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="16dp" android:paddingTop="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/mute_title" android:textSize="16sp" android:textColor="@color/text" />
                    <TextView android:id="@+id/mute_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/text_muted" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/mute_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Members: me, then who is in range, then everyone else heard from lately -->
            <TextView android:id="@+id/members_header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="20dp"
                android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:id="@+id/members_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" android:paddingTop="4dp" android:paddingBottom="4dp">
                <LinearLayout android:id="@+id/members" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView android:id="@+id/members_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="12dp"
                    android:textAppearance="@style/Text.Muted" android:visibility="gone" />
                <TextView android:id="@+id/view_all" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground" android:textColor="@color/ember" android:textSize="15sp"
                    android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>

            <!-- A group this phone left: the private chats kept with its chat, each opened to read -->
            <TextView android:id="@+id/private_header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="20dp"
                android:text="@string/left_private_chats" android:textAppearance="@style/Text.Section" android:textSize="12sp"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/private_chats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:paddingTop="4dp"
                android:paddingBottom="4dp" android:visibility="gone" />

            <!-- A group this phone is in: clear its chat (this phone only), or leave.
                 A group it left: rejoin, or delete it from this phone for good -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_card" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:id="@+id/clear_chat" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_clear_chat" android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground" android:text="@string/menu_clear_chat"
                    android:textColor="@color/danger" android:textSize="16sp" />
                <TextView android:id="@+id/leave" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_exit_group" android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground" android:text="@string/leave_group"
                    android:textColor="@color/danger" android:textSize="16sp" />
                <TextView android:id="@+id/rejoin" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_rejoin_group" android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground" android:text="@string/menu_rejoin_group"
                    android:textColor="@color/text" android:textSize="16sp" android:visibility="gone" />
                <TextView android:id="@+id/delete_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_chat_delete" android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground" android:text="@string/menu_delete_group"
                    android:textColor="@color/danger" android:textSize="16sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
