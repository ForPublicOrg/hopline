<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand" app:titleTextColor="#FFFFFF" app:subtitleTextColor="#D8F3E6"
        app:menu="@menu/main" app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <TextView android:id="@+id/warn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/accent" android:textColor="@color/text" android:padding="10dp" android:gravity="center"
        android:textSize="15sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/errand_cards" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" />

    <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:gravity="center" android:textAppearance="@style/Text.Muted" android:visibility="gone" />

    <ProgressBar android:id="@+id/hold" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="0"
        android:progressTint="@color/sos" android:visibility="invisible" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="8dp" android:background="@color/surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/help" android:layout_width="wrap_content" android:layout_height="56dp"
            android:text="@string/help_btn" android:textSize="15sp" android:textStyle="bold"
            app:backgroundTint="@color/sos" android:layout_marginEnd="8dp" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:insetTop="0dp" android:insetBottom="0dp" />

        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="@string/message_hint" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:maxLength="2000"
            android:textSize="18sp" android:background="@drawable/bg_input" android:padding="14dp" android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send" android:layout_width="wrap_content" android:layout_height="56dp"
            android:text="@string/send" android:layout_marginStart="8dp" android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>
</LinearLayout>
