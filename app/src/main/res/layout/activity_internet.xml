<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" app:title="@string/internet_title" app:titleTextColor="@color/text"
        app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text" android:elevation="2dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="16dp">

            <!-- What this is -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_card" android:padding="18dp">
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_badge">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                        android:src="@drawable/ic_globe" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="@string/internet_hero" android:textAppearance="@style/Text.Title" android:textSize="20sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/internet_intro" android:textAppearance="@style/Text.Muted" android:textSize="14.5sp" />
                <TextView android:id="@+id/helper" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/bg_field"
                    android:textAppearance="@style/Text.Body" android:textSize="14.5sp" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout android:id="@+id/sendout" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/sendout_btn" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/sendout_sub" android:textSize="13sp" android:textColor="@color/text_muted" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout android:id="@+id/readlink" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/readlink_btn" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="@string/readlink_sub" android:textSize="13sp" android:textColor="@color/text_muted" />
                </LinearLayout>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- My side of the bargain -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:padding="16dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/share" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/share_internet" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="@string/share_internet_sub" android:textSize="13sp" android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginStart="4dp" android:text="@string/your_requests" android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:id="@+id/errands" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/none" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:layout_marginStart="4dp"
                android:text="@string/requests_empty" android:textAppearance="@style/Text.Muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
