<?xml version="1.0" encoding="utf-8"?>
<!-- Pay without internet: one page that explains *99# and opens it. The *99# box asks for the UPI
     ID and the amount itself, so nothing is asked here. No background of its own: the window
     already paints @color/bg underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/surface" app:title="@string/pay_title" app:titleTextColor="@color/text"
        app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text"
        app:navigationContentDescription="@string/back" android:elevation="2dp" />

    <ScrollView
        android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="16dp" android:paddingBottom="28dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bg_card" android:padding="24dp">
                <TextView android:layout_width="88dp" android:layout_height="88dp" android:gravity="center"
                    android:background="@drawable/bg_net_icon" android:importantForAccessibility="no"
                    android:text="@string/pay_rupee" android:textSize="40sp" android:textStyle="bold"
                    android:textColor="@color/internet_badge" />
                <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/pay_hero_title"
                    android:textAppearance="@style/Text.Title" android:textSize="22sp" android:gravity="center" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/pay_hero_body"
                    android:textAppearance="@style/Text.Muted" android:textSize="15sp" android:gravity="center"
                    android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/go"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                    android:text="@string/pay_go" />
            </LinearLayout>

            <!-- Notes about right now, re-checked while the screen is in front -->
            <TextView android:id="@+id/online_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_field" android:padding="14dp"
                android:text="@string/pay_note_online" android:textSize="14sp" android:textColor="@color/text"
                android:visibility="gone" />
            <TextView android:id="@+id/signal_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_warn_card" android:padding="14dp"
                android:text="@string/pay_note_no_signal" android:textSize="14sp" android:textColor="@color/warn_text"
                android:visibility="gone" />
            <TextView android:id="@+id/jio_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_warn_card" android:padding="14dp"
                android:text="@string/pay_note_jio" android:textSize="14sp" android:textColor="@color/warn_text"
                android:visibility="gone" />

            <TextView android:id="@+id/steps_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginStart="4dp" android:text="@string/pay_steps"
                android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/bg_card"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="16dp" />

            <TextView android:id="@+id/know_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginStart="4dp" android:text="@string/pay_know"
                android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/bg_card"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:id="@+id/know_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp"
                    android:background="@color/divider" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="@string/pay_know_setup" android:textSize="14sp" android:textColor="@color/text"
                    android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/setup"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="-12dp"
                    android:minHeight="48dp" android:text="@string/pay_setup_btn" android:textAllCaps="false"
                    android:textSize="15sp" android:textStyle="bold" style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <!-- What each thing the *99# box may say means, and what to do -->
            <TextView android:id="@+id/help_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:layout_marginStart="4dp" android:text="@string/pay_help_title"
                android:textAppearance="@style/Text.Section" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/bg_card"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="16dp">
                <LinearLayout android:id="@+id/help_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/open_menu"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/pay_open_menu" style="@style/Widget.Hopline.Button.Quiet" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
