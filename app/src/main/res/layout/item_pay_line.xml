<?xml version="1.0" encoding="utf-8"?>
<!-- One short line of a list ("Good to know", "What went wrong?"), after a bullet dot that sits on
     its first line however many lines it wraps to. Filled in code; never saves its own state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginTop="8dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/pay_bullet" android:textSize="14sp" android:textColor="@color/text_muted"
        android:importantForAccessibility="no" />

    <TextView android:id="@+id/text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:saveEnabled="false"
        android:textSize="14sp" android:textColor="@color/text" android:lineSpacingExtra="2dp" android:textAlignment="viewStart" />
</LinearLayout>
