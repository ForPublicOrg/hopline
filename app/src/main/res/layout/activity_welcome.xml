<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="32dp">

        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <FrameLayout android:layout_width="120dp" android:layout_height="120dp">
            <View android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/bg_hero_circle" />
            <ImageView android:layout_width="120dp" android:layout_height="120dp"
                android:src="@drawable/ic_launcher_foreground" android:scaleType="centerCrop"
                android:scaleX="1.5" android:scaleY="1.5" android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/welcome_title" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/tagline" android:gravity="center" android:textSize="17sp" android:textColor="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/welcome_how_1" android:gravity="center" android:textSize="14sp" android:textColor="@color/text_muted" />

        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/whats_your_name" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:background="@drawable/bg_input_pill"
            android:hint="@string/name_hint" android:inputType="textPersonName|textCapWords" android:maxLength="20"
            android:textSize="18sp" android:textColor="@color/text" android:textColorHint="@color/text_faint"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:singleLine="true" android:imeOptions="actionDone"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton android:id="@+id/go" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/lets_go" />
    </LinearLayout>
</ScrollView>
