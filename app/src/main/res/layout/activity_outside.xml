<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand" app:title="@string/outside_world" app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_back" app:navigationIconTint="#FFFFFF" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/outside_intro" android:textAppearance="@style/Text.Body" />

            <TextView android:id="@+id/helper" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/bg_card"
                android:textAppearance="@style/Text.Body" />

            <com.google.android.material.button.MaterialButton android:id="@+id/weather" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/weather_btn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sendout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/sendout_btn" />
            <com.google.android.material.button.MaterialButton android:id="@+id/readlink" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/readlink_btn" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="Your requests" android:textAppearance="@style/Text.Title" />
            <LinearLayout android:id="@+id/errands" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/none" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nothing yet. Answers also appear in the group chat so everyone can read them." android:textAppearance="@style/Text.Muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
