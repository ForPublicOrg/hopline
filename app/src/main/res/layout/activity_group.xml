<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="-12dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" android:contentDescription="@string/back" android:visibility="gone" />

        <TextView android:id="@+id/hello" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textAppearance="@style/Text.Display" android:textSize="28sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_start" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_add" app:tint="@color/ember" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp"
                        android:text="@string/start_group" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/start_group_sub" android:textAppearance="@style/Text.Muted" />
                <LinearLayout android:id="@+id/start_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/group_name_layout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/group_name_hint" app:counterEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_name" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapSentences"
                            android:textSize="20sp" android:singleLine="true" android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/start_btn" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/start" />
                    <!-- While the group's key is worked out (a few seconds), and what went wrong if it couldn't be saved -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/start_progress"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:indeterminate="true" android:visibility="gone" android:importantForAccessibility="no"
                        app:indicatorColor="@color/ember" app:trackColor="@color/surface_variant" app:trackCornerRadius="2dp" />
                    <TextView android:id="@+id/start_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/group_not_saved" android:textColor="@color/danger" android:visibility="gone" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_join" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_qr" app:tint="@color/ember" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp"
                        android:text="@string/join_group" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/join_group_sub" android:textAppearance="@style/Text.Muted" />
                <LinearLayout android:id="@+id/join_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
                    <!-- Four words don't fit one line at this size: the field wraps (GroupActivity), Done still joins -->
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/code_hint" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/code" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textNoSuggestions|textVisiblePassword"
                            android:textSize="22sp" android:imeOptions="actionDone"
                            android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/code_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/bad_code" android:textColor="@color/danger" android:visibility="gone" android:layout_marginTop="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/join_btn" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/join" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/join_progress"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:indeterminate="true" android:visibility="gone" android:importantForAccessibility="no"
                        app:indicatorColor="@color/ember" app:trackColor="@color/surface_variant" app:trackCornerRadius="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/scan_btn" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/scan_qr"
                        style="@style/Widget.Hopline.Button.Quiet" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
