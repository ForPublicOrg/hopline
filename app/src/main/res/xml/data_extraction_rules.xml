<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Hopline's leaves the phone: not in a cloud backup, and not when a new phone is set up
     from this one. A copy would be a second phone with this one's key — able to read its private
     chats, and taken for it by everyone else. A new phone starts as a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
