    <string name="chat_status_let_go">Not sent — this phone let it go before any phone in range took it. Tap Send again to try once more.</string>
    <string name="chat_status_let_go_final">Not sent — this phone let it go before any phone in range took it.</string>
    <string name="chat_status_left_sent">Sent. You left before Hopline could confirm who got it.</string>
