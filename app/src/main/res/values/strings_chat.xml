    <string name="chat_status_update_unsent">Not sent — it hadn\'t gone out when Hopline was updated. Tap Send again to try once more.</string>
    <string name="chat_status_update_unsent_final">Not sent — it hadn\'t gone out when Hopline was updated.</string>
    <string name="chat_status_update_unsent_dm">Not sent — it hadn\'t gone out when Hopline was updated. To keep talking, open %1$s from People.</string>
